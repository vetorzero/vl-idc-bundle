{
    "name": "vetorzero/vl-idc-bundle",
    "description": "Integração com a Central de Identidade Vetor Zero (vl-idc).",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "firebase/php-jwt": "^7.2",
        "league/oauth2-client": "^2.9",
        "psr/log": "^3.0",
        "symfony/cache-contracts": "^3.6",
        "symfony/config": "^7.4 || ^8.1",
        "symfony/dependency-injection": "^7.4 || ^8.1",
        "symfony/event-dispatcher-contracts": "^3.6",
        "symfony/http-client-contracts": "^3.6",
        "symfony/http-foundation": "^7.4 || ^8.1",
        "symfony/http-kernel": "^7.4 || ^8.1",
        "symfony/routing": "^7.4 || ^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5.42",
        "symfony/cache": "^7.4 || ^8.1",
        "symfony/event-dispatcher": "^7.4 || ^8.1",
        "symfony/http-client": "^7.4 || ^8.1"
    },
    "autoload": {
        "psr-4": {
            "VetorZero\\VlIdcBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VetorZero\\VlIdcBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
